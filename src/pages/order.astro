---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Order placed">
  <section class="wrap thanks">
    <p class="eyebrow">Shukriya!</p>
    <h1 class="page">Your order is placed</h1>
    <p id="detail" class="lead">We'll send a confirmation shortly.</p>
    <p class="muted">Orders are packed within 24 hours and delivered in 2–5 days.</p>
    <a class="btn" href="/">Keep browsing</a>
  </section>
</Layout>

<script>
  import { inr } from '../scripts/store.js'
  const o = JSON.parse(sessionStorage.getItem('ds_last_order') || 'null')
  if (o) {
    document.getElementById('detail').textContent =
      `Order ${o.id} · ${o.items} item${o.items > 1 ? 's' : ''} · ${inr(o.total)} · ${o.payment === 'upi' ? 'UPI on delivery' : 'Cash on delivery'}`
  }
</script>
