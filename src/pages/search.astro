---
import Layout from '../layouts/Layout.astro'
import { allProducts } from '../data/store.js'
const index = allProducts.map((b) => ({ sku: b.sku, slug: b.slug, title: b.title, maker: b.maker, category: b.category, color: b.color }))
---
<Layout title="Search">
  <section class="wrap">
    <h1 class="page">Search</h1>
    <form id="sf" class="search"><input name="q" placeholder="Name or fabric" autocomplete="off" /><button class="btn" type="submit">Search</button></form>
    <p id="count" class="muted"></p>
    <div id="results" class="grid" data-index={JSON.stringify(index)}></div>
  </section>
</Layout>

<script>
  import { paintPrices } from '../scripts/store.js'
  const box = document.getElementById('results')
  const index = JSON.parse(box.dataset.index)
  const input = document.querySelector('#sf input')
  function run(q) {
    const t = q.trim().toLowerCase()
    const hits = t ? index.filter((b) => `${b.title} ${b.maker} ${b.category}`.toLowerCase().includes(t)) : []
    document.getElementById('count').textContent = t ? `${hits.length} result${hits.length === 1 ? '' : 's'} for “${q}”` : ''
    box.innerHTML = hits.map((b) => `<article class="card"><a href="/product/${b.slug}" class="card-link">
      <div class="cover" style="--c:${b.color}"><span class="c-title">${b.title}</span><span class="c-rule"></span><span class="c-author">${b.maker}</span></div>
      <h3>${b.title}</h3><p class="by">${b.maker}</p></a><p class="price loading" data-price-sku="${b.sku}">&nbsp;</p></article>`).join('')
    paintPrices()
  }
  const q = new URLSearchParams(location.search).get('q') || ''
  input.value = q
  run(q)
  document.getElementById('sf').addEventListener('submit', (e) => {
    e.preventDefault()
    history.replaceState(null, '', '/search?q=' + encodeURIComponent(input.value))
    run(input.value)
  })
</script>
