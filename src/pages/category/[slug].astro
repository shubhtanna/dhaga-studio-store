---
import Layout from '../../layouts/Layout.astro'
import ProductCard from '../../components/ProductCard.astro'
import { CATEGORIES, inCategory } from '../../data/store.js'

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }))
}
const { cat } = Astro.props
const items = inCategory(cat.slug)
---
<Layout title={cat.name} description={`${cat.name} at Dhaga Studio: ${cat.blurb}.`}>
  <section class="wrap">
    <p class="crumbs"><a href="/">Home</a> / {cat.name}</p>
    <h1 class="page">{cat.name}</h1>
    <p class="muted">{cat.blurb} · {items.length} pieces</p>
    <div class="grid">{items.map((b) => <ProductCard item={b} />)}</div>
  </section>
</Layout>

<script>
  import { paintPrices, wireAddButtons } from '../../scripts/store.js'
  paintPrices()
  wireAddButtons()
</script>
