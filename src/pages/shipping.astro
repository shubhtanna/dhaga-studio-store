---
import Layout from '../layouts/Layout.astro'
import { FREE_SHIPPING_FROM, SHIPPING_FEE } from '../data/store.js'
---
<Layout title="Shipping & returns">
  <section class="wrap prose">
    <h1 class="page">Shipping &amp; returns</h1>
    <h3>Delivery</h3>
    <p>Free delivery on orders above ₹{FREE_SHIPPING_FROM}; otherwise ₹{SHIPPING_FEE}. Metro cities in 2–3 days, the rest of India in 3–5 days.</p>
    <h3>Payment</h3>
    <p>Cash on delivery or UPI on delivery, all over India.</p>
    <h3>Returns</h3>
    <p>Damaged or wrong piece? Tell us within 7 days of delivery and we'll replace it free.</p>
  </section>
</Layout>
