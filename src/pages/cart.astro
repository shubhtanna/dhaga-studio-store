---
import Layout from '../layouts/Layout.astro'
import { allProducts, FREE_SHIPPING_FROM, SHIPPING_FEE } from '../data/store.js'
const catalogue = Object.fromEntries(allProducts.map((b) => [b.sku, { title: b.title, maker: b.maker, slug: b.slug, color: b.color }]))
---
<Layout title="Your bag">
  <section class="wrap">
    <h1 class="page">Your bag</h1>
    <div id="bag" class="bag" data-catalogue={JSON.stringify(catalogue)} data-free={FREE_SHIPPING_FROM} data-fee={SHIPPING_FEE}>
      <p class="muted">Loading your bag…</p>
    </div>
  </section>
</Layout>

<script>
  import { readCart, writeCart, loadPrices, inr } from '../scripts/store.js'
  const box = document.getElementById('bag')
  const catalogue = JSON.parse(box.dataset.catalogue)
  const FREE = Number(box.dataset.free), FEE = Number(box.dataset.fee)

  async function render() {
    const prices = await loadPrices()
    const lines = readCart().filter((l) => catalogue[l.sku])
    if (!lines.length) {
      box.innerHTML = '<p class="muted">Your bag is empty.</p><a class="btn" href="/">Find something to wear</a>'
      return
    }
    const subtotal = lines.reduce((s, l) => s + prices[l.sku].price * l.qty, 0)
    const ship = subtotal >= FREE ? 0 : FEE
    box.innerHTML = `
      <div class="bag-lines">${lines.map((l) => {
        const b = catalogue[l.sku]
        return `<div class="line">
          <span class="mini" style="--c:${b.color}"></span>
          <div><a href="/product/${b.slug}">${b.title}</a><small>${b.maker}</small></div>
          <div class="qty"><button type="button" data-dec="${l.sku}">−</button><span>${l.qty}</span><button type="button" data-inc="${l.sku}">+</button></div>
          <strong>${inr(prices[l.sku].price * l.qty)}</strong>
          <button type="button" class="link" data-del="${l.sku}">Remove</button>
        </div>`
      }).join('')}</div>
      <aside class="sum">
        <p><span>Subtotal</span><span>${inr(subtotal)}</span></p>
        <p><span>Delivery</span><span>${ship ? inr(ship) : 'Free'}</span></p>
        <p class="total"><span>Total</span><span>${inr(subtotal + ship)}</span></p>
        ${ship ? `<p class="note">Add ${inr(FREE - subtotal)} more for free delivery.</p>` : ''}
        <button type="button" class="btn wide" id="go">Checkout</button>
      </aside>`
    document.getElementById('go').onclick = () => (location.href = '/checkout')
  }

  box.addEventListener('click', (e) => {
    const t = e.target.closest('button')
    if (!t) return
    const lines = readCart()
    const sku = t.dataset.inc || t.dataset.dec || t.dataset.del
    const line = lines.find((l) => l.sku === sku)
    if (!line) return
    if (t.dataset.inc) line.qty = Math.min(5, line.qty + 1)
    if (t.dataset.dec) line.qty -= 1
    writeCart(t.dataset.del ? lines.filter((l) => l.sku !== sku) : lines.filter((l) => l.qty > 0))
    render()
  })
  render()
</script>
