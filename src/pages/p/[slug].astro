---
import Base from '../../layouts/Base.astro'
import Swatch from '../../components/Swatch.astro'
import Tile from '../../components/Tile.astro'
import { items, collectionName } from '../../data/shop.js'

export function getStaticPaths() {
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }))
}
const { item } = Astro.props
const alike = items.filter((i) => i.collection === item.collection && i.slug !== item.slug).slice(0, 4)
---
<Base title={`${item.name}, ${item.region}`} description={item.story}>
  <section class="wrap">
    <p class="crumbs"><a href="/">Home</a><span>/</span><a href={`/collections/${item.collection}`}>{collectionName(item.collection)}</a><span>/</span>{item.name}</p>
    <div class="item">
      <div class="item-pic"><Swatch item={item} size="lg" /></div>
      <div class="item-info">
        <p class="kicker">{collectionName(item.collection)}</p>
        <h1>{item.name}</h1>
        <p class="made">Handwoven in {item.region}</p>
        <p class="rating"><span class="stars" style={`--r:${item.rating}`}>★★★★★</span> {item.rating} <span class="dim">· {item.fabric}</span></p>
        <span class="cost lg" data-cost={item.sku}>&nbsp;</span>
        <p class="stock" data-stock={item.sku}>In stock · ships in 1–2 days</p>
        <div class="buy">
          <label class="qty">Qty<input id="qty" type="number" min="1" max="5" value="1" /></label>
          <button type="button" class="btn grow" data-add={item.sku}>Add to bag</button>
        </div>
        <p class="story-text">{item.story}</p>
        <dl class="specs">
          <div><dt>Fabric</dt><dd>{item.fabric}</dd></div>
          <div><dt>Size</dt><dd>{item.size}</dd></div>
          <div><dt>Made in</dt><dd>{item.region}</dd></div>
          <div><dt>Item code</dt><dd>{item.sku}</dd></div>
        </dl>
        <div class="assure">
          <p><b>Free delivery</b> on larger orders · <a class="text-link" href="/delivery">details</a></p>
          <p><b>Pay on delivery</b> cash or UPI</p>
          <p><b>7-day replacement</b> if damaged</p>
        </div>
      </div>
    </div>
  </section>
  <section class="wrap band">
    <div class="band-head"><h2>More {collectionName(item.collection).toLowerCase()}</h2></div>
    <div class="shelf">{alike.map((i) => <Tile item={i} />)}</div>
  </section>
</Base>

<script>
  import { fillCosts, bindAddButtons } from '../../scripts/bag.js'
  fillCosts()
  bindAddButtons()
</script>
