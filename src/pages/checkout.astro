---
import Base from '../layouts/Base.astro'
import { items, DELIVERY } from '../data/shop.js'
const names = Object.fromEntries(items.map((i) => [i.sku, i.name]))
---
<Base title="Checkout">
  <section class="wrap">
    <p class="crumbs"><a href="/bag">Bag</a><span>/</span>Checkout</p>
    <h1 class="title">Checkout</h1>
    <div class="pay" id="pay" data-names={JSON.stringify(names)} data-free={DELIVERY.freeFrom} data-fee={DELIVERY.fee}>
      <form class="form" id="details" novalidate>
        <h3>Where should we send it?</h3>
        <label>Full name<input type="text" name="name" autocomplete="name" /></label>
        <label>Mobile number<input type="tel" name="phone" autocomplete="tel" inputmode="numeric" /></label>
        <label>Email<input type="email" name="email" autocomplete="email" /></label>
        <label>Address<input type="text" name="address" autocomplete="street-address" /></label>
        <div class="two">
          <label>City<input type="text" name="city" autocomplete="address-level2" /></label>
          <label>PIN code<input type="text" name="pin" inputmode="numeric" maxlength="6" /></label>
        </div>
        <h3>How will you pay?</h3>
        <label class="choice"><input type="radio" name="how" value="cash" checked /> Cash on delivery</label>
        <label class="choice"><input type="radio" name="how" value="upi" /> UPI on delivery</label>
        <p class="problem" id="problem" hidden></p>
        <button class="btn wide" type="submit">Place order</button>
        <p class="dim small">Demo store: nothing is charged or shipped.</p>
      </form>
      <aside class="total-box" id="summary"><p class="dim">Loading…</p></aside>
    </div>
  </section>
</Base>

<script>
  import { getBag, saveBag, loadCatalog, rupees } from '../scripts/bag.js'
  const pay = document.getElementById('pay')
  const names = JSON.parse(pay.dataset.names)
  const FREE = Number(pay.dataset.free)
  const FEE = Number(pay.dataset.fee)
  const bag = getBag()
  const skus = Object.keys(bag).filter((s) => names[s] && bag[s] > 0)
  if (!skus.length) location.replace('/bag')
  let grand = 0

  loadCatalog().then((live) => {
    const subtotal = skus.reduce((s, k) => s + live[k].price * bag[k], 0)
    const delivery = subtotal >= FREE ? 0 : FEE
    grand = subtotal + delivery
    document.getElementById('summary').innerHTML =
      '<h3>Your order</h3>' +
      skus.map((k) => `<p><span>${names[k]} × ${bag[k]}</span><span>${rupees(live[k].price * bag[k])}</span></p>`).join('') +
      `<p><span>Delivery</span><span>${delivery ? rupees(delivery) : 'Free'}</span></p><p class="grand"><span>Total</span><span>${rupees(grand)}</span></p>`
  })

  document.getElementById('details').addEventListener('submit', (e) => {
    e.preventDefault()
    const f = Object.fromEntries(new FormData(e.target))
    const missing = []
    if (f.name.trim().length < 2) missing.push('your name')
    if (!/^[6-9]\d{9}$/.test(f.phone.replace(/\D/g, '').slice(-10))) missing.push('a 10-digit mobile number')
    if (!/^\S+@\S+\.\S+$/.test(f.email)) missing.push('a valid email')
    if (f.address.trim().length < 6) missing.push('your address')
    if (!f.city.trim()) missing.push('your city')
    if (!/^\d{6}$/.test(f.pin)) missing.push('a 6-digit PIN code')
    const box = document.getElementById('problem')
    if (missing.length) {
      box.textContent = 'Please add ' + missing.join(', ') + '.'
      box.hidden = false
      return
    }
    const ref = 'DHG' + Date.now().toString().slice(-7)
    sessionStorage.setItem('dhaga:last', JSON.stringify({ ref, grand, pieces: skus.length, how: f.how }))
    saveBag({})
    location.href = '/thanks?ref=' + ref
  })
</script>
