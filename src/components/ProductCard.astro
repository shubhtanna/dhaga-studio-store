---
import Cover from './Cover.astro'
const { item } = Astro.props
---
<article class="card">
  <a href={`/product/${item.slug}`} class="card-link">
    <Cover item={item} />
    <h3>{item.title}</h3>
    <p class="by">{item.maker}</p>
  </a>
  <p class="price loading" data-price-sku={item.sku}>&nbsp;</p>
  <button type="button" class="btn small" data-add={item.sku}>Add to bag</button>
</article>
